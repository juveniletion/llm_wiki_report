# =============================================================================
# pharma-cost-wiki 环境变量样例
# -----------------------------------------------------------------------------
# 用法：复制成 .env 并填值。
#     cp .env.example .env
#
# ⚠️ `.env` **绝不进版本库**（.gitignore 与 .dockerignore 都已排除）。
#    这里只放**键名与说明**，不放任何真实密钥。
#
# ⚠️ 全部都是**可选**的：不配也能启动，只是部分功能不可用。
#    各功能缺什么、会怎么表现，逐条写在下面。
# =============================================================================

# ---- 大模型（报告叙述、问答、对标归因）-------------------------------------
# 缺了会怎样：报告生成 / 智能问答 / 对标归因**不可用**，
#             接口返回结构化错误（501 + 明确提示），不会静默失败。
# 看板、知识图谱、登录、数据浏览**不受影响**。
DEEPSEEK_API_KEY=

# 兼容 OpenAI 格式的服务地址。留空用官方 https://api.deepseek.com
DEEPSEEK_BASE_URL=

# Agent 用哪个模型。默认 deepseek-chat
AGENT_MODEL=deepseek-chat

# ---- 检索的向量侧（混合检索里的语义部分）-----------------------------------
# 缺了会怎样：**自动降级为纯 BM25 关键词检索**，功能不中断。
#   （BM25 对本项目的中文术语检索已经够用；向量侧主要补语义相似。）
# 走的是一次 HTTP 调用，不引入 sentence-transformers（那会拖进 torch）。
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
# 小模型（多模型协作里的"取数"那一路）。默认 Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_MODEL=

# ---- 数据位置 ---------------------------------------------------------------
# ⚠️ 这是 **LLM_WIKI_DATA**（数据根目录），不是 LLM_WIKI_DB。
#    后者是"单一数据库"时代的遗留变量，现在只在 paths.describe() 里
#    被读来做提示文字、**不参与路径解析**——改它没有任何效果。
#
# 容器里由 docker-compose.yml 固定为 /data（挂记忆卷），一般不用改这里。
# 本机直跑脚本时可用它把数据根指向别处；留空则用 <仓库>/data。
# LLM_WIKI_DATA=

# ---- Docker：数据挂载源（只对 docker compose 生效）-------------------------
# 指向**数据仓库**的路径，compose 会把它的 raw/wiki/state/graph（只读）
# 与 reports/exports（可写）挂进容器。
#
#   不设（默认 `.`）→ 用当前目录，即仓库内自带的**样例**数据
#   设为真数据目录 → 跑真实数据，镜像与代码都不用改
#
# 例：WIKI_DATA_DIR=C:/Users/me/pharma-cost-wiki
# WIKI_DATA_DIR=.

# ---- Docker：监听地址与端口（只对 docker compose 生效）---------------------
# ⚠️ 默认只绑 127.0.0.1 —— **不对外暴露**。
#    原因：本服务的**只读看板免登录**（/api/overview、/api/trend、/api/heatmap
#    等无须账号即可读取）。一旦绑到 0.0.0.0，同一网络内**任何人都能看到成本数据**。
#
# 要让别人（评委、同事）在局域网内访问你机器上的服务：
#    1) 打开下面两行（即设 WIKI_BIND=0.0.0.0）
#    2) docker compose up -d
#    3) 查明本机 IP：Windows `ipconfig`，macOS/Linux `ifconfig | grep inet`
#    4) 对方浏览器访问 http://<你的IP>:<端口>
#
# 只改端口（如 8765 被占用）：WIKI_PORT=8899 即可，绑定地址不用动。
# 演示结束后建议改回 127.0.0.1 并重启，避免长期暴露。
# WIKI_BIND=0.0.0.0
# WIKI_PORT=8765

# ---- 容器内才需要设的（本机直跑别设）--------------------------------------
# RPA mock 的地址。容器里 `127.0.0.1` 指容器自己，必须用 compose 服务名。
# 由 docker-compose.yml 注入，这里列出来只为说明它存在。
# 本机直跑脚本时留空即可（默认 http://127.0.0.1:8090）。
# RPA_BASE_URL=http://rpa-mock:8090

# 导出 PDF 用的中文字体名。留空则按平台自动选
# （Windows→Microsoft YaHei、macOS→PingFang SC、Linux→Noto Sans CJK SC）。
# 装了别的字体才需要设。
# CJK_FONT=

# 生产部署**必须**设为 1：让会话 Cookie 只在 HTTPS 下发送。
# 本机 HTTP 调试时留空（否则浏览器不发送 Cookie，登录会失效）。
# LW_COOKIE_SECURE=1
