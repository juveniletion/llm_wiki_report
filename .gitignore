# =============================================================================
# 赛题提供的数据与文档 —— **严禁外传**
# -----------------------------------------------------------------------------
# 赛题原文（六、6.3 开发约束 / 十、其他说明）：
#   「所有赛题数据仅限本次大赛使用，严禁外传」
#   「参赛者须签署保密承诺，不得将数据用于任何商业用途或向第三方传播」
#
# 因此下列目录**不进入公开仓库**：成本明细 CSV、行业参考数据、
# 制药知识文档（配方/工艺/GMP/设备清单）、出题方给的报告模板与 RPA 接口文档。
#
# 运行时需要这些数据。获取方式见 DATA_NOTICE.md。
# =============================================================================
data/
raw/

# ---- 由数据派生、同样含数据的中间层 ----
wiki/          # 知识编译层：正文大量复述配方/工艺/GMP 原文
state/         # 关键数值快照（来自成本 CSV）
graph/         # 知识图谱派生视图
reports/       # 已生成报告（含具体成本数字）
exports/       # Word/PDF 产物（含图与数字）
*.db
users/
shared/

# =============================================================================
# 密钥与运行态 —— 一旦提交就永久留在 git 历史里，删不干净
# =============================================================================
.env
.env.*
!.env.example
*.key
*.pem

# =============================================================================
# Python 构建产物
# =============================================================================
__pycache__/
*.py[cod]
build/
dist/
*.egg-info
.venv/
venv/
